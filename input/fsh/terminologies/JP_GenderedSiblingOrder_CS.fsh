// Gendered labels for same-sex sibling ordering
* #GSO1_M "長男"
* #GSO1_F "長女"
* #GSO2_M "次男"
* #GSO2_F "次女"
* #GSO3_M "三男"
* #GSO3_F "三女"
* #GSO4_M "四男"
* #GSO4_F "四女"
* #GSO5_M "五男"
* #GSO5_F "五女"
* #GSO6_M "六男"
* #GSO6_F "六女"
* #GSO7_M "七男"
* #GSO7_F "七女"
* #GSO8_M "八男"
* #GSO8_F "八女"
* #GSO9_M "九男"
* #GSO9_F "九女"
* #GSO10_M "十男"
* #GSO10_F "十女"

