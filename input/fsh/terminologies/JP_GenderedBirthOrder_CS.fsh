CodeSystem: JP_GenderedBirthOrder_CS
Id: jp-genderedbirthorder-cs
Title: "JP Core Gendered Birth Order CodeSystem"
Description: "同性同胞内での出生順を表す日本語ラベル（長男、長女、次男、次女など）を定義するCodeSystem。社会学的・文化的表現。"
* ^url = "http://jpfhir.jp/fhir/core/CodeSystem/JP_GenderedBirthOrder_CS"
* ^status = #active
* ^experimental = false
* ^date = "2025-12-01"
* ^publisher = "（一社）日本医療情報学会"
* ^copyright = "（一社）日本医療情報学会. CC BY-ND 4.0"
* ^content = #complete

// Gendered labels for same-sex sibling ordering
* #GBO1_M "長男"
* #GBO1_F "長女"
* #GBO2_M "次男"
* #GBO2_F "次女"
* #GBO3_M "三男"
* #GBO3_F "三女"
* #GBO4_M "四男"
* #GBO4_F "四女"
* #GBO5_M "五男"
* #GBO5_F "五女"
* #GBO6_M "六男"
* #GBO6_F "六女"
* #GBO7_M "七男"
* #GBO7_F "七女"
* #GBO8_M "八男"
* #GBO8_F "八女"
* #GBO9_M "九男"
* #GBO9_F "九女"
* #GBO10_M "十男"
* #GBO10_F "十女"

// 備考: この CodeSystem は日本固有の社会学的・文化的表現を提供します。医学的に厳密な遺伝情報については、GA4GH等のプロファイルを参照してください。